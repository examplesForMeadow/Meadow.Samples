<Project Sdk="Meadow.Sdk/1.1.0">
    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <OutputType>Library</OutputType>
        <AssemblyName>App</AssemblyName>
        <LangVersion>10.0</LangVersion>
    </PropertyGroup>
    <!--
      TEMPORARY: using released 2.x NuGet packages because the boards run Meadow OS 2.5.2.1
      and no net9.0-compatible Meadow OS has shipped yet. When it does, restore the original
      ProjectReferences:
        ..\..\..\..\..\Meadow.Core\Source\implementations\f7\Meadow.F7\Meadow.F7.csproj
        ..\..\..\..\..\Meadow.Foundation\Source\Meadow.Foundation.Core\Meadow.Foundation.Core.csproj
    -->
    <ItemGroup>
        <PackageReference Include="Meadow.F7" Version="2.*" />
        <PackageReference Include="Meadow.Foundation" Version="2.*" />
    </ItemGroup>
</Project>
