<Project Sdk="Meadow.Sdk/1.1.0">
    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <OutputType>Library</OutputType>
        <AssemblyName>App</AssemblyName>
        <LangVersion>10.0</LangVersion>
    </PropertyGroup>
    <ItemGroup>
        <None Remove="w_clear.jpg" />
        <None Remove="w_cloudy.jpg" />
        <None Remove="w_drizzle.jpg" />
        <None Remove="w_misc.jpg" />
        <None Remove="w_rain.jpg" />
        <None Remove="w_snow.jpg" />
        <None Remove="w_storm.jpg" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="w_drizzle.jpg" />
        <EmbeddedResource Include="w_clear.jpg" />
        <EmbeddedResource Include="w_cloudy.jpg" />
        <EmbeddedResource Include="w_misc.jpg" />
        <EmbeddedResource Include="w_rain.jpg" />
        <EmbeddedResource Include="w_snow.jpg" />
        <EmbeddedResource Include="w_storm.jpg" />
    </ItemGroup>
    <!--
      TEMPORARY: using released 2.x NuGet packages because the boards run Meadow OS 2.5.2.1
      and no net9.0-compatible Meadow OS has shipped yet. When it does, restore the original
      ProjectReferences:
        ..\..\..\..\Meadow.Core\Source\implementations\f7\Meadow.F7\Meadow.F7.csproj
        ..\..\..\..\Meadow.Foundation\Source\Meadow.Foundation.Core\Meadow.Foundation.Core.csproj
        ..\..\..\..\Meadow.Foundation\Source\Meadow.Foundation.Peripherals\Displays.TftSpi\Driver\Displays.TftSpi.csproj
    -->
    <ItemGroup>
        <PackageReference Include="Meadow.F7" Version="2.*" />
        <PackageReference Include="Meadow.Foundation" Version="2.*" />
        <PackageReference Include="Meadow.Foundation.Displays.TftSpi" Version="2.*" />
        <PackageReference Include="Meadow.Foundation.Graphics.MicroGraphics" Version="2.*" />
        <PackageReference Include="SimpleJpegDecoder" Version="*" />
    </ItemGroup>
    <ItemGroup>
        <None Update="meadow.config.yaml">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
</Project>
