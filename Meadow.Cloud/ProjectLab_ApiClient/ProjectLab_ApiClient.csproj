<Project Sdk="Meadow.Sdk/1.1.0">
    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <OutputType>Library</OutputType>
        <AssemblyName>App</AssemblyName>
        <LangVersion>10.0</LangVersion>
    </PropertyGroup>
    <ItemGroup>
        <None Remove="Resources\img_meadow.bmp" />
        <None Remove="Resources\img_refreshed.bmp" />
        <None Remove="Resources\img_refreshing.bmp" />
        <None Remove="Resources\img_wifi_connected.bmp" />
        <None Remove="Resources\img_wifi_connecting.bmp" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="Resources\img_meadow.bmp" />
        <EmbeddedResource Include="Resources\img_refreshed.bmp" />
        <EmbeddedResource Include="Resources\img_refreshing.bmp" />
        <EmbeddedResource Include="Resources\img_wifi_connected.bmp" />
        <EmbeddedResource Include="Resources\img_wifi_connecting.bmp" />
    </ItemGroup>
    <ItemGroup>
        <None Update="app.build.yaml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="meadow.config.yaml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="app.config.yaml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="wifi.config.yaml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <!--
      TEMPORARY: using released 2.x NuGet packages because the boards run Meadow OS 2.5.2.1
      and no net9.0-compatible Meadow OS has shipped yet. When it does, restore the original
      ProjectReferences:
        ..\..\..\..\Meadow.Foundation\Source\Meadow.Foundation.Libraries_and_Frameworks\Graphics.MicroLayout\Driver\Graphics.MicroLayout.csproj
        ..\..\..\..\Meadow.ProjectLab\Source\Meadow.ProjectLab\Meadow.ProjectLab.csproj
    -->
    <ItemGroup>
        <PackageReference Include="Meadow.F7" Version="2.*" />
        <PackageReference Include="Meadow.ProjectLab" Version="*" />
        <PackageReference Include="Meadow.Foundation.Graphics.MicroLayout" Version="2.*" />
    </ItemGroup>
</Project>
