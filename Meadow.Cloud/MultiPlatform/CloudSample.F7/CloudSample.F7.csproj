<Project Sdk="Meadow.Sdk/1.1.0">
    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <OutputType>Library</OutputType>
        <AssemblyName>App</AssemblyName>
        <LangVersion>10.0</LangVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <!--
      TEMPORARY: using released 2.x NuGet packages because the boards run Meadow OS 2.5.2.1
      and no net9.0-compatible Meadow OS has shipped yet. When it does, restore the original
      ProjectReferences:
        ..\..\..\..\..\Meadow.Core\Source\implementations\f7\Meadow.F7\Meadow.F7.csproj
        ..\..\..\..\..\Meadow.Foundation\Source\Meadow.Foundation.Core\Meadow.Foundation.Core.csproj
      (CloudSample.Core is sample-local shared code and stays a ProjectReference.)
    -->
    <ItemGroup>
      <PackageReference Include="Meadow.F7" Version="2.*" />
      <PackageReference Include="Meadow.Foundation" Version="2.*" />
      <ProjectReference Include="..\CloudSample.Core\CloudSample.Core.csproj" />
    </ItemGroup>
    <ItemGroup>
        <None Update="meadow.config.yaml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="app.config.yaml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="wifi.config.yaml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>
</Project>
