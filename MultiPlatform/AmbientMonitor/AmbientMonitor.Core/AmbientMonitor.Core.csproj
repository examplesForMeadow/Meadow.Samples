<Project Sdk="Meadow.Sdk/1.1.0">
    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <OutputType>Library</OutputType>
        <LangVersion>10</LangVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <ItemGroup>
      <None Remove="Assets\img-sync-fade.bmp" />
      <None Remove="Assets\img-sync.bmp" />
      <None Remove="Assets\img-wifi-fade.bmp" />
      <None Remove="Assets\img-wifi.bmp" />
      <None Remove="Assets\img_meadow.bmp" />
      <None Remove="Assets\img_refreshed.bmp" />
      <None Remove="Assets\img_refreshing.bmp" />
      <None Remove="Assets\img_wifi_connected.bmp" />
      <None Remove="Assets\img_wifi_connecting.bmp" />
    </ItemGroup>
    <ItemGroup>
      <EmbeddedResource Include="Assets\img-sync-fade.bmp" />
      <EmbeddedResource Include="Assets\img-sync.bmp" />
      <EmbeddedResource Include="Assets\img-wifi-fade.bmp" />
      <EmbeddedResource Include="Assets\img-wifi.bmp" />
      <EmbeddedResource Include="Assets\img_meadow.bmp" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Meadow.Foundation" Version="2.*" />
      <PackageReference Include="Meadow.Foundation.Graphics.MicroLayout" Version="2.*" />
      <PackageReference Include="Meadow.Logging.LogProviders" Version="2.*" />
    </ItemGroup>
