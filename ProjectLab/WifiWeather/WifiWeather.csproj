        <None Remove="w_rain.bmp" />
        <None Remove="w_snow.bmp" />
        <None Remove="w_storm.bmp" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="Resources\img_meadow.bmp" />
        <EmbeddedResource Include="Resources\img_refreshing.bmp" />
