<Project Sdk="Meadow.Sdk/1.1.0">
    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <OutputType>Library</OutputType>
        <AssemblyName>App</AssemblyName>
        <LangVersion>10.0</LangVersion>
    </PropertyGroup>
    <ItemGroup>
        <None Remove="Resources\img_ble.bmp" />
        <None Remove="Resources\img_ble_fade.bmp" />
        <None Remove="Resources\img_meadow.bmp" />
        <None Remove="Resources\img_wifi.bmp" />
        <None Remove="Resources\img_wifi_fade.bmp" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="Resources\img_ble.bmp" />
        <EmbeddedResource Include="Resources\img_ble_fade.bmp" />
        <EmbeddedResource Include="Resources\img_meadow.bmp" />
        <EmbeddedResource Include="Resources\img_wifi.bmp" />
        <EmbeddedResource Include="Resources\img_wifi_fade.bmp" />
    </ItemGroup>
    <!--
      TEMPORARY: using released 2.x NuGet packages because the boards run Meadow OS 2.5.2.1
      and no net9.0-compatible Meadow OS has shipped yet. When it does, restore the original
      ProjectReferences:
        ..\..\..\..\..\Maple\Source\Web.Maple.Server\Web.Maple.Server.csproj
        ..\..\..\..\..\Meadow.Foundation\Source\Meadow.Foundation.Libraries_and_Frameworks\Graphics.MicroLayout\Driver\Graphics.MicroLayout.csproj
        ..\..\..\..\..\Meadow.ProjectLab\Source\Meadow.ProjectLab\Meadow.ProjectLab.csproj
    -->
    <ItemGroup>
        <PackageReference Include="Meadow.F7" Version="2.*" />
        <PackageReference Include="Meadow.ProjectLab" Version="*" />
        <PackageReference Include="Meadow.Foundation.Graphics.MicroLayout" Version="2.*" />
        <PackageReference Include="Meadow.Foundation.Web.Maple.Server" Version="2.*" />
    </ItemGroup>
    <ItemGroup>
        <None Update="app.build.yaml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="app.config.yaml">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <Import Project="..\ProjectLabConnectivity.Common\ProjectLabConnectivity.Common.projitems" Label="Shared" />
</Project>
